{
  "name": "plm-translator-capm",
  "version": "1.0.0",
  "description": "PLM Translator built on SAP BTP CAP Model with Google Cloud Translation API v2",
  "repository": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.15.0",
    "express": "^4",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy:local": "cds deploy --to sqlite:db/plm_translator.db",
    "deploy:hana": "cds deploy --to hana"
  },
  "ui5": {
    "ui5parser": {
      "excludeFolderPatterns": [
        "**/resources/**",
        "**/dist/**",
        "**/node_modules/**",
        "**/Component-preload.js"
      ]
    },
    "ui5linter": {
      "jsClassExceptions": [
        "plm.translator.app.Component-preload"
      ]
    }
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "database": "db/plm_translator.db"
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "password": "alice",
            "roles": [ "TranslatorAdmin", "TranslatorUser", "admin", "authenticated-user" ]
          },
          "bob": {
            "password": "bob",
            "roles": [ "TranslatorUser", "authenticated-user" ]
          },
          "*": {
            "roles": [ "TranslatorAdmin", "TranslatorUser", "authenticated-user" ]
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
