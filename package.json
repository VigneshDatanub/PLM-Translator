{
  "name": "plm-translator-capm",
  "version": "1.0.7",
  "description": "PLM Translator built on SAP BTP CAP Model with Google Cloud Translation API v2",
  "repository": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.15.0",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy:local": "cds deploy --to sqlite",
    "deploy:hana": "cds deploy --to hana"
  },
  "ui5": {
    "ui5parser": {
      "excludeFolderPatterns": [
        "**/resources/**",
        "**/dist/**",
        "**/node_modules/**",
        "**/lib/**"
      ]
    },
    "ui5linter": {
      "jsLinterExceptions": [
        {
          "className": "plm.translator.app.ext.customActions",
          "memberName": "onQuickTranslate",
          "applyToChildren": true
        },
        {
          "className": "plm.translator.app.ext.customActions",
          "memberName": "onMassUpload",
          "applyToChildren": true
        }
      ]
    }
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "basic",
        "login_required": true,
        "users": {
          "alice": {
            "password": "alice",
            "roles": [ "TranslatorAdmin", "authenticated-user" ]
          },
          "bob": {
            "password": "bob",
            "roles": [ "TranslatorUser", "authenticated-user" ]
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
