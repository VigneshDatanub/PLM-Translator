{
  "typescript.validate.enable": false,
  "javascript.validate.enable": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "mta-op-*": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/gen": true
  },
  "files.watcherExclude": {
    "**/gen/**": true
  },
  "ui5plugin.linter.exceptions": [
    "**/Component-preload.js"
  ],
  "ui5plugin.linter.jsClassExceptions": [
    "plm.translator.app.Component-preload"
  ],
  "ui5.plugin.excludeFolderPatterns": [
    "**/Component-preload.js"
  ],
  "ui5.plugin.jsClassExceptions": [
    "plm.translator.app.Component-preload"
  ],
  "sqltools.connections": []
}
