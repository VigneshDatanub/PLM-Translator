{
  "typescript.validate.enable": false,
  "javascript.validate.enable": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "mta-op-*": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/gen": true
  },
  "files.watcherExclude": {
    "**/gen/**": true
  },
  "ui5plugin.linter.exceptions": [
    "**/lib/**"
  ],
  "ui5plugin.linter.jsLinterExceptions": [
    {
      "className": "plm.translator.app.ext.customActions",
      "memberName": "onQuickTranslate",
      "applyToChildren": true
    },
    {
      "className": "plm.translator.app.ext.customActions",
      "memberName": "onMassUpload",
      "applyToChildren": true
    }
  ],
  "ui5.plugin.excludeFolderPatterns": [
    "**/lib/**"
  ],
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "driver": "SQLite",
      "name": "mydb",
      "database": "db.sqlite"
    }
  ],
  "sqltools.useNodeRuntime": true
}