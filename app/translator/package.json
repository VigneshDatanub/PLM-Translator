{
  "name": "plm-translator-ui5",
  "version": "1.0.9",
  "description": "UI5 Frontend for PLM Translator",
  "scripts": {
    "build": "node -e \"fs.mkdirSync('dist', {recursive: true})\" && tar -a -cf dist/plmtranslatorapp.zip -C webapp *"
  },
  "ui5": {
    "ui5parser": {
      "excludeFolderPatterns": [
        "**/lib/**",
        "**/libs/**"
      ]
    },
    "ui5linter": {
      "jsLinterExceptions": [
        {
          "className": "plm.translator.app.ext.customActions",
          "memberName": "onQuickTranslate",
          "applyToChildren": true
        },
        {
          "className": "plm.translator.app.ext.customActions",
          "memberName": "onMassUpload",
          "applyToChildren": true
        }
      ]
    }
  }
}
