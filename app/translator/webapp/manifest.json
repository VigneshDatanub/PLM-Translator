{
    "_version": "1.65.0",
    "sap.app": {
        "id": "plm.translator.app",
        "type": "application",
        "title": "PLM Translation Workbench",
        "description": "PLM Translation Tool powered by Google Cloud Translation API and SAP Fiori Elements",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "crossNavigation": {
            "inbounds": {
                "PLMTranslator-manage": {
                    "semanticObject": "PLMTranslator",
                    "action": "manage",
                    "title": "PLM Translator",
                    "subTitle": "Google Cloud Translation Tool",
                    "icon": "sap-icon://translate",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        },
        "dataSources": {
            "mainService": {
                "uri": "api/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.cloud": {
        "public": true,
        "service": "plmtranslator"
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://translate"
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ushell": {},
                "sap.fe.core": {},
                "sap.fe.templates": {},
                "sap.ui.unified": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.fe.templates.ListReport.ListReportController": {
                        "controllerName": "plm.translator.app.ext.customActions"
                    }
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.f.routing.Router"
            },
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "TestResultsList",
                    "target": "TestResultsList"
                },
                {
                    "pattern": "TestResults({key}):?query:",
                    "name": "TestResultsObjectPage",
                    "target": "TestResultsObjectPage"
                }
            ],
            "targets": {
                "TestResultsList": {
                    "type": "Component",
                    "id": "TestResultsList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/TestResults",
                            "variantManagement": "Page",
                            "initialLoad": "Enabled",
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "ResponsiveTable"
                                    },
                                    "actions": {
                                        "QuickTranslateAction": {
                                            "press": ".extension.plm.translator.app.ext.customActions.onQuickTranslate",
                                            "visible": true,
                                            "text": "Quick Translate"
                                        },
                                        "MassUploadAction": {
                                            "press": ".extension.plm.translator.app.ext.customActions.onMassUpload",
                                            "visible": true,
                                            "text": "Mass Translation (Excel)"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "TestResultsObjectPage": {
                    "type": "Component",
                    "id": "TestResultsObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/TestResults"
                        }
                    }
                }
            }
        }
    }
}
