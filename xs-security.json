{
  "xsappname": "plm-translator-dev",
  "tenant-mode": "dedicated",
  "description": "Security configuration for PLM Translator",
  "oauth2-configuration": {
    "grant-types": [
      "authorization_code",
      "refresh_token",
      "urn:ietf:params:oauth:grant-type:jwt-bearer",
      "user_token",
      "client_credentials"
    ],
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/**",
      "https://*.hana.ondemand.com/**",
      "https://*.workzone.cfapps.*.hana.ondemand.com/**",
      "https://*.launchpad.cfapps.*.hana.ondemand.com/**",
      "https://*.accounts.ondemand.com/**",
      "https://*.ondemand.com/**"
    ]
  },
  "scopes": [
    {
      "name": "uaa.user",
      "description": "UAA default user scope"
    },
    {
      "name": "$XSAPPNAME.TranslatorUser",
      "description": "User access to PLM Translator"
    },
    {
      "name": "$XSAPPNAME.TranslatorAdmin",
      "description": "Administrator access to PLM Translator"
    }
  ],
  "role-templates": [
    {
      "name": "Token_Exchange",
      "description": "Role template allowing UAA Token Exchange",
      "scope-references": [
        "uaa.user"
      ]
    },
    {
      "name": "TranslatorUserRole",
      "description": "Role for translating text and running tests",
      "scope-references": [
        "$XSAPPNAME.TranslatorUser"
      ]
    },
    {
      "name": "TranslatorAdminRole",
      "description": "Role for full administration and results management",
      "scope-references": [
        "$XSAPPNAME.TranslatorAdmin"
      ]
    }
  ]
}
